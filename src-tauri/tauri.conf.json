{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pupitre",
  "version": "0.1.0",
  "identifier": "fr.clementserizay.pupitre",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run prepare:tauri-dev && bun run --cwd ui dev",
    "beforeBuildCommand": "bun run tauri:before-build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "externalBin": [
      "binaries/pupitre-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
