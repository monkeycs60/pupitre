{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pupitre",
  "version": "0.1.0",
  "identifier": "fr.clementserizay.pupitre",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ui dev",
    "beforeBuildCommand": "bun run tauri:before-build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pupitre",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:4820 ws://127.0.0.1:4820",
        "img-src": "'self' data: blob: http://127.0.0.1:4820",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "externalBin": [
      "binaries/pupitre-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
