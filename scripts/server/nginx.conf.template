worker_processes 1;
pid /run/pupitre-web/nginx.pid;
error_log stderr warn;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_body_temp_path /run/pupitre-web/body;
    proxy_temp_path /run/pupitre-web/proxy;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_origin $pupitre_origin_allowed {
        default 0;
        '' 1;
        'https://__HOST__' 1;
    }
    server {
        listen 127.0.0.1:4880;
        server_name __HOST__;
        root /var/www/pupitre;
        client_max_body_size 32m;
        if ($host != '__HOST__') { return 403; }
        if ($http_tailscale_user_login != '__LOGIN__') { return 403; }
        if ($pupitre_origin_allowed = 0) { return 403; }
        if ($http_sec_fetch_site = 'cross-site') { return 403; }
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header Cache-Control 'no-store' always;
        location ~ ^/(api(?:/|$)|media(?:/|$)|ws$) {
            proxy_pass http://127.0.0.1:4820;
            proxy_http_version 1.1;
            proxy_set_header Host 127.0.0.1:4820;
            # Le sidecar reste local ; seul ce gateway valide l'identité et l'origine distantes.
            proxy_set_header Origin http://127.0.0.1:4880;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 86400s;
        }
        location / { try_files $uri $uri/ /index.html; }
    }
}
