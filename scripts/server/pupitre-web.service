[Unit]
Description=Pupitre private web gateway
After=network-online.target pupitre.service
Wants=pupitre.service
StartLimitIntervalSec=0

[Service]
User=www-data
Group=www-data
RuntimeDirectory=pupitre-web
ExecStartPre=/usr/sbin/nginx -t -c /etc/pupitre/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/pupitre/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/pupitre/nginx.conf -s reload
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/pupitre-web

[Install]
WantedBy=multi-user.target
